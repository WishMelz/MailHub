# 与 docker-compose.yml 放在同一目录并复制为 .env；本机默认值可直接启动。
PUBLIC_ORIGIN=http://localhost:8080
APP_PORT=8080
IMAGE_TAG=latest

# Microsoft OAuth 为可选功能，可在首次登录后再配置。
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_OAUTH_SCOPES=openid profile email offline_access User.Read Mail.ReadWrite
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Google OAuth 为可选功能。需启用 Gmail API，创建 External + Testing consent screen，
# Testing 仅用于临时联调，Gmail Refresh Token 通常约 7 天失效；长期无感使用需发布为 Production。
# 创建 Web OAuth 客户端，并按 Google Cloud Console 要求完成适用的应用验证。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# 只读邮件所需的完整权限；不要添加 gmail.modify、gmail.compose、gmail.send 或 mail.google.com。
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.readonly
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
# Gmail API 请求最小间隔（毫秒），所有账户共享同一请求队列。
GOOGLE_GMAIL_REQUEST_INTERVAL_MS=100
# 每次同步每个 Gmail 文件夹只扫描最近一页，控制该页最多读取的邮件数。
GOOGLE_GMAIL_SYNC_PAGE_SIZE=25

# Gmail users.watch + Pub/Sub 实时通知。完成 GCP Topic、IAM 和 Push Subscription 配置后再开启。
GOOGLE_GMAIL_WATCH_ENABLED=false
GOOGLE_CLOUD_PROJECT_ID=
# 可填写 Topic 名称，或完整的 projects/<project>/topics/<topic> 资源名。
GOOGLE_GMAIL_PUBSUB_TOPIC=
GOOGLE_GMAIL_PUBSUB_AUDIENCE=
GOOGLE_GMAIL_PUBSUB_SERVICE_ACCOUNT=
GOOGLE_GMAIL_PUBSUB_SUBSCRIPTION=
GOOGLE_GMAIL_WATCH_DEFAULT_MINUTES=30
GOOGLE_GMAIL_WATCH_RENEW_BEFORE_MINUTES=1440
GOOGLE_GMAIL_HISTORY_PAGE_SIZE=100
GOOGLE_GMAIL_HISTORY_RETRY_LIMIT=5
GOOGLE_GMAIL_COMPENSATION_INTERVAL_MINUTES=60
# 已成功 Push 事件的数据库保留时间（小时）。
GOOGLE_GMAIL_PUSH_EVENT_RETENTION_HOURS=168

# 高级可选项。HTTPS 会根据 PUBLIC_ORIGIN 自动启用 Secure Cookie。
# AUTH_SESSION_TTL_HOURS=168
# AUTH_COOKIE_NAME=outlook_manage_session
# AUTH_COOKIE_SECURE=
# TRUST_PROXY_HOPS=1
# ADMIN_SETUP_TOKEN=
# ENCRYPTION_KEY_PREVIOUS=
# OUTBOUND_HTTP_TIMEOUT_MS=30000
# MAIL_SYNC_TIMEOUT_MS=300000
# ATTACHMENT_MAX_BYTES=26214400
# DB_LOGGING=false

# 当前主密钥不写入配置。首次启动自动生成 ./data/encryption.key，
# 后续启动始终复用它；迁移时必须与 ./data/outlook-manage.sqlite 一起复制。